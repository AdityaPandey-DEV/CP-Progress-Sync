# ==========================================================
# Competitive Programming AI Revision Hub - Environment Variables
# ==========================================================

# 1. MongoDB Database URI (for caching AI explanations and revision progress)
# Get a free cloud database at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/competitive-programming?retryWrites=true&w=majority

# 2. Google Gemini API Key (100% Free Tier - 15 RPM / 1500 RPD)
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq Cloud API Key (100% Free Tier - ultra fast LLaMA 3.3 70B & 8B)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
